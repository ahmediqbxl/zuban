# Supabase — used only for optional account sync. The app is fully
# functional offline with these unset.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Web Push. Without it, reminders still work while the app is open but
# cannot fire when it is closed. Generate with: npx web-push generate-vapid-keys
PUBLIC_VAPID_KEY=
