{
  "name": "zuban",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Learn the languages the big platforms ignore. Bangla first.",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:content": "tsx scripts/build-content.ts",
    "content:stats": "tsx scripts/content-stats.ts",
    "content:audio": "tsx scripts/generate-audio.ts",
    "fonts:fetch": "node scripts/fetch-fonts.mjs",
    "audio:generate": "node scripts/generate-audio.mjs",
    "audio:plan": "node scripts/generate-audio.mjs --dry-run",
    "test:e2e": "node tests/e2e/smoke.mjs",
    "test:e2e:prod": "node tests/e2e/smoke.mjs --prod",
    "test:e2e:speaking": "node tests/e2e/smoke.mjs --speaking",
    "test:e2e:wrong": "node tests/e2e/smoke.mjs --wrong",
    "review:export": "node scripts/review-export.mjs",
    "review:import": "node scripts/review-import.mjs",
    "review:status": "tsx scripts/build-content.ts"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.8.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@types/node": "^26.2.0",
    "playwright": "^1.62.1",
    "svelte": "^5.1.0",
    "svelte-check": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "idb": "^8.0.0",
    "ts-fsrs": "^4.4.0"
  }
}
